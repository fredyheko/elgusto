rules_version = '2';
// Правила безопасности базы L'Gusto.
// ВАЖНО: впиши email(ы) операторов в список ниже — только они видят и меняют заказы.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOp() {
      return request.auth != null
        && request.auth.token.email in ['operator@example.com'];
    }

    function validOrder(d) {
      return d.keys().hasOnly(['items','subtotal','deliveryFee','total','mode','zone','name','phone','addr','comment','pay','lang','status','num','createdAt','updatedAt'])
        && d.status == 'new'
        && d.items is list && d.items.size() > 0 && d.items.size() <= 60
        && d.total is number && d.total > 0 && d.total < 100000
        && d.subtotal is number && d.deliveryFee is number
        && d.mode in ['delivery','pickup']
        && d.zone in ['city','other','']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.phone is string && d.phone.matches('^(0[2-9][0-9]{7}|[+][0-9]{8,15})$')
        && !exists(/databases/$(database)/documents/blocked/$(d.phone))
        && getAfter(/databases/$(database)/documents/limits/$(d.phone)).data.at == request.time
        && d.addr is string && d.addr.size() <= 200
        && d.comment is string && d.comment.size() <= 300
        && d.pay in ['cash','mia','card']
        && d.lang in ['ro','ru']
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.num == getAfter(/databases/$(database)/documents/meta/counter).data.n;
    }

    // Заказы: клиент может только создать новый и посмотреть свой (по секретному id).
    match /orders/{id} {
      allow create: if validOrder(request.resource.data);
      allow get: if true;
      allow list: if isOp();
      allow update: if isOp()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['new','accepted','cooking','delivery','done','cancelled'];
      allow delete: if false;
    }

    // Счётчик номеров заказов: только +1.
    match /meta/counter {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // Лимит заказов с одного номера: не больше 3 за час.
    // Пишется в той же транзакции, что и заказ (см. getAfter в validOrder).
    match /limits/{phone} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['win','n','at'])
        && request.resource.data.n == 1
        && request.resource.data.win == request.time && request.resource.data.at == request.time;
      allow update: if request.resource.data.keys().hasOnly(['win','n','at'])
        && request.resource.data.at == request.time
        && (
          (request.time > resource.data.win + duration.value(1, 'h')
            && request.resource.data.n == 1 && request.resource.data.win == request.time)
          || (request.time <= resource.data.win + duration.value(1, 'h')
            && request.resource.data.win == resource.data.win
            && request.resource.data.n == resource.data.n + 1
            && request.resource.data.n <= 3)
        );
      allow delete: if isOp();
    }

    // Заблокированные номера: проверяет сайт, ведёт оператор.
    match /blocked/{phone} {
      allow get: if true;
      allow list, write: if isOp();
    }

    // Настройки (приём заказов открыт/закрыт, стоп-лист): читают все, меняет оператор.
    match /meta/settings {
      allow get: if true;
      allow write: if isOp();
    }
  }
}
